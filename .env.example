# Copiá este archivo como .env (que está en .gitignore) y completá tu clave.
# La consulta por IP de la API de Shodan requiere una cuenta con membresía y no consume créditos de consulta.
# Sin clave, Baqueano usa InternetDB, la API gratuita de Shodan (menos detalle).
SHODAN_API_KEY=

# Opcional: clave gratuita de la NVD (https://nvd.nist.gov/developers/request-an-api-key).
# Sin clave funciona igual, pero las consultas a la NVD son 10 veces más lentas.
NVD_API_KEY=

# Opcional: Censys como segunda fuente (Platform API). Cada consulta de host consume créditos.
CENSYS_API_TOKEN=
CENSYS_ORG_ID=
CENSYS_MAX_LOOKUPS=100

# Alertas (opcional). Las URL de Slack/Teams/webhook se cargan en el panel; acá van las credenciales.
BAQUEANO_URL=http://127.0.0.1:8080
BAQUEANO_WEBHOOK_SECRET=
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
